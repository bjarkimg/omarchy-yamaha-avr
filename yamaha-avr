#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
SESSION_SCRIPT="${YAMAHA_AVR_SESSION:-$SCRIPT_DIR/yamaha-avr-session.py}"
DEVICE_HOST="${YAMAHA_AVR_HOST:-}"
DEVICE_NAME="${YAMAHA_AVR_NAME:-Yamaha AVR}"

usage() {
  cat <<'EOF'
Usage: yamaha-avr [--host HOST] [--name NAME] ACTION

  power mute volume-up volume-down status
  input-hdmi1 .. input-hdmi5
  scene-1 .. scene-4
  straight pure-direct program-7ch
  session

YNCA HTTP remote for Yamaha RX-V / RX-A receivers (tested on RX-V677).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --host)
    DEVICE_HOST="$2"
    shift 2
    ;;
  --name)
    DEVICE_NAME="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

[[ $# -eq 1 ]] || {
  usage >&2
  exit 2
}

if [[ $1 == session ]]; then
  exec python3 "$SESSION_SCRIPT" --host "$DEVICE_HOST" --name "$DEVICE_NAME"
fi

echo "yamaha-avr: one-shot actions run through the bar session" >&2
exit 2
