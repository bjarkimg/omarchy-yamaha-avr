#!/bin/bash

set -euo pipefail

export PATH="/usr/bin:/bin"

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
SESSION_SCRIPT="$SCRIPT_DIR/yamaha-avr-session.py"
DEVICE_HOST="${YAMAHA_AVR_HOST:-}"
DEVICE_NAME="${YAMAHA_AVR_NAME:-Yamaha AVR}"

usage() {
  cat <<'EOF'
Usage: yamaha-avr [--host HOST] [--name NAME] ACTION

  power mute volume-up volume-down status
  input-hdmi1 .. input-hdmi5
  scene-1 .. scene-4
  straight pure-direct program-7ch
  session

YNCA HTTP remote for Yamaha RX-V / RX-A receivers (tested on RX-V677).
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --host)
    DEVICE_HOST="$2"
    shift 2
    ;;
  --name)
    DEVICE_NAME="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

[[ $# -eq 1 ]] || {
  usage >&2
  exit 2
}

PYTHON_BIN=""
for candidate in /usr/bin/python3 /bin/python3; do
  if [[ -x "$candidate" ]]; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [[ -z "$PYTHON_BIN" ]]; then
  echo "yamaha-avr: python3 not found in /usr/bin or /bin" >&2
  exit 1
fi

if [[ $1 == session ]]; then
  exec "$PYTHON_BIN" "$SESSION_SCRIPT" --host "$DEVICE_HOST" --name "$DEVICE_NAME"
fi

printf '%s\nquit\n' "$1" | "$PYTHON_BIN" "$SESSION_SCRIPT" --host "$DEVICE_HOST" --name "$DEVICE_NAME"
