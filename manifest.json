{
  "schemaVersion": 1,
  "id": "io.github.bjarkimg.yamaha-avr",
  "name": "Yamaha AVR",
  "version": "1.0.1",
  "author": "Bjarki Már",
  "license": "MIT",
  "description": "Bar remote for Yamaha network AV receivers over YNCA. Power, volume, HDMI, Straight / 7ch Stereo / Pure Direct, and a draggable 7.1 seat map. Tested on RX-V677.",
  "homepage": "https://github.com/bjarkimg/omarchy-yamaha-avr",
  "repository": "https://github.com/bjarkimg/omarchy-yamaha-avr",
  "keywords": [
    "bar",
    "media",
    "remote",
    "yamaha",
    "avr",
    "ynca"
  ],
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Yamaha AVR",
    "description": "Remote for Yamaha RX-V / RX-A receivers over the LAN",
    "category": "Controls",
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "deviceName": "Yamaha AVR",
      "host": ""
    },
    "schema": [
      {
        "key": "deviceName",
        "type": "string",
        "label": "Receiver name",
        "defaultValue": "Yamaha AVR"
      },
      {
        "key": "host",
        "type": "string",
        "label": "Receiver IP",
        "defaultValue": ""
      }
    ]
  }
}
